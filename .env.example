# Copy to .env and set your own passwords:   cp .env.example .env
# .env is gitignored — never commit real credentials.
# docker compose overrides the *_HOST and *_PORT values below with its service
# names and internal ports; they matter when running scripts on the host.

# --- PostgreSQL (historical candles) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cryptobot

# --- MongoDB (live candles + predictions) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=cryptobot
MONGO_PASSWORD=change_me
MONGO_DB=cryptobot

# --- Optional ---
# Where an EMPTY Postgres starts its backfill (DD.MM.YYYYThh:mm).
# Default: HISTORICAL_START_DATE in src/params/constants.py
# HISTORICAL_START_DATE=01.10.2026T00:00

# --- Model storage ---
# Unset MODEL_S3_BUCKET = local file models/model.pkl (docker compose, kind).
# On AWS: the versioned S3 bucket and the object key of the model.
# MODEL_S3_BUCKET=cryptobot-models-example
# MODEL_S3_KEY=dev/model.pkl
# AWS_REGION=eu-central-1
# How often (seconds) the API checks for a newer model; default 60.
# MODEL_CHECK_INTERVAL_SECONDS=60

# --- AWS only (Amazon DocumentDB / RDS); leave unset for local databases ---
# DocumentDB requires TLS; this also sets retryWrites=false.
# MONGO_TLS=true
# MONGO_TLS_CA_FILE=/path/to/aws-ca-bundle.pem
# RDS for PostgreSQL requires SSL: "require" encrypts, "verify-full" also checks the server.
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/path/to/aws-ca-bundle.pem
