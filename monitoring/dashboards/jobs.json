{
  "uid": "cryptobot-jobs",
  "title": "CryptoBot / Scheduled jobs and pods",
  "description": "The CronJobs ingest and retrain (latest result, timing, history) and the health of all pods in the namespace. Data from kube-state-metrics and the kubelet.",
  "tags": [
    "cryptobot"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "links": [
    {
      "title": "CryptoBot dashboards",
      "type": "dashboards",
      "tags": [
        "cryptobot"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kube_cronjob_info, namespace)",
        "query": {
          "query": "label_values(kube_cronjob_info, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest run of each scheduled job",
      "description": "FAILED: its newest failed run is newer than its newest successful run, the same test as the alert \"Scheduled job failed\" (stays FAILED while the next run is going). RUNNING: a run is going and the previous one succeeded. OK: the latest run succeeded. NO RUN YET: no run is kept. Runs started by hand count too.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cronjob) (label_replace(max by (owner_name) (kube_job_status_start_time{namespace=\"$namespace\"} * on (namespace, job_name) group_left (owner_name) kube_job_owner{namespace=\"$namespace\", owner_kind=\"CronJob\"} and on (namespace, job_name) kube_job_failed{namespace=\"$namespace\", condition=\"true\"} == 1) > on (owner_name) (max by (owner_name) (kube_job_status_start_time{namespace=\"$namespace\"} * on (namespace, job_name) group_left (owner_name) kube_job_owner{namespace=\"$namespace\", owner_kind=\"CronJob\"} and on (namespace, job_name) kube_job_complete{namespace=\"$namespace\", condition=\"true\"} == 1) or max by (owner_name) (kube_job_owner{namespace=\"$namespace\", owner_kind=\"CronJob\"}) * 0), \"cronjob\", \"$1\", \"owner_name\", \"(.+)\")) * 0 + 1\nor\n(max by (cronjob) (kube_cronjob_status_active{namespace=\"$namespace\"}) > 0) * 0 + 2\nor\n(max by (cronjob) (kube_cronjob_info{namespace=\"$namespace\"}) * 0 + 3)\n  unless on (cronjob) max by (cronjob) (label_replace(kube_job_owner{namespace=\"$namespace\", owner_kind=\"CronJob\"}, \"cronjob\", \"$1\", \"owner_name\", \"(.+)\"))\nor\nmax by (cronjob) (kube_cronjob_info{namespace=\"$namespace\"}) * 0",
          "refId": "A",
          "legendFormat": "{{cronjob}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "RUNNING",
                  "color": "blue",
                  "index": 2
                },
                "3": {
                  "text": "NO RUN YET",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Since the last successful run",
      "description": "ingest runs every 15 minutes and retrain once a day (03:00 UTC), so these values should stay below about 20 minutes and 25 hours.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (cronjob) (kube_cronjob_status_last_successful_time{namespace=\"$namespace\"})",
          "refId": "A",
          "legendFormat": "{{cronjob}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Next scheduled run in",
      "description": "Time until Kubernetes starts the next scheduled run of each CronJob. A value that stays negative means a scheduled start was missed or delayed (for example, the cluster was off at that time); it corrects itself after the next scheduled run.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cronjob) (kube_cronjob_next_schedule_time{namespace=\"$namespace\"}) - time()",
          "refId": "A",
          "legendFormat": "{{cronjob}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Duration of the successful Jobs kept in history",
      "description": "Kubernetes keeps the last 3 successful and 3 failed runs (Jobs) of each CronJob, runs started by hand included, and the init-db Job for 10 minutes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job_name) (kube_job_status_completion_time{namespace=\"$namespace\"} - kube_job_status_start_time{namespace=\"$namespace\"})",
          "refId": "A",
          "legendFormat": "{{job_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Failed Jobs kept in history",
      "description": "Each failed Job that Kubernetes still keeps. Read its logs with kubectl logs job/<name>. They disappear as newer runs replace them.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job_name) (kube_job_failed{namespace=\"$namespace\", condition=\"true\"} == 1)",
          "refId": "A",
          "legendFormat": "{{job_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pods not ready",
      "description": "Pods that are running, starting or waiting for a node, but not ready (for example the API while a database does not answer, a container that keeps crashing, or a pod that no node has room for).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kube_pod_status_phase{namespace=\"$namespace\", phase=~\"Pending|Running\"} == 1 unless on (namespace, pod) kube_pod_status_ready{namespace=\"$namespace\", condition=\"true\"} == 1) or vector(0)",
          "refId": "A",
          "legendFormat": "pods",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Container restarts in the last hour",
      "description": "Restarts per container name. A restart means the container crashed, ran out of memory, or failed its liveness check.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{container}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory per pod",
      "description": "Working-set memory of each pod (the sum of its containers). Each pod's memory limit applies to it alone: prod's two API pods are two lines.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"})",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
