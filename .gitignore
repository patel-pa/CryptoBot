# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration
.env

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
.vscode/

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# exclude data from source control by default
/data/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Ruff cache
.ruff_cache/

# Virtual Environment
.venv/
venv/

# Others
PROJECT_CONTEXT.md
cryptobot_timeline*

# Local Kubernetes (kind) passwords: real values, never committed (see *.env.example)
k8s/overlays/local/*.env

# Written at deploy time: names the image in ECR, whose address contains the AWS account ID
/k8s/deploy/

# Trained models are build output, not source: S3 on AWS, a local file otherwise.
models/*.pkl

# Terraform: downloaded providers, local state and saved plans never go into Git
# (state lives in S3). The provider lock file .terraform.lock.hcl IS committed.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
*_override.tf
crash.log

# Keep the ENTIRE references/ directory LOCAL only — phase reports, defense
# deck, course notes stay on disk but are never pushed to the CV repo.
/references/
