# Python caches
__pycache__/
*.py[cod]

# Test and lint caches
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Local settings with passwords (see .env.example)
.env

# Editors and operating systems
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Logs
*.log

# Local data, never in source control
/data/

# Local Kubernetes (kind) passwords: real values, never committed (see *.env.example)
k8s/overlays/local/*.env

# Written at deploy time: names the image in ECR, whose address contains the AWS account ID
/k8s/deploy/

# Trained models are build output, not source: S3 on AWS, a local file otherwise. The
# whole folder, so a temporary file left by an interrupted save stays out too.
/models/

# Terraform: downloaded providers, local state and saved plans never go into Git
# (state lives in S3). The provider lock file .terraform.lock.hcl IS committed.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
*_override.tf

# Local notes, never published
/references/
