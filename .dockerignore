# Keep the build context (and image) small and free of secrets.
# Every hidden file and folder: .git, .github, local settings and caches, and
# .env (passwords, passed in at runtime via env_file / Secrets, never baked in).
.*

# Kubernetes manifests are applied with kubectl and never needed in the image;
# k8s/overlays/local/*.env holds the local (kind) passwords.
k8s

# Terraform code (and its local state and provider downloads) is never needed in the image.
infra

# Local Python environments / caches
venv
__pycache__
*.pyc

# The trained model is never baked into the image: it comes from S3 (AWS)
# or the shared models volume (docker compose).
models/*.pkl

# Not needed inside the runtime image
notebooks
references
*.md
